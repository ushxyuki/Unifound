<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#E0E7FF"
            android:text="← Back to Home"
            android:textAllCaps="false"
            android:textColor="#2563EB"
            android:textStyle="bold" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report Lost Item"
            android:textColor="#111827"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Verify your student details and describe the lost item"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Student ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student ID"
                    android:textColor="#111827"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etStudentId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Example: 22014567"
                    android:inputType="number"
                    android:padding="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8" />

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="University Email"
                    android:textColor="#111827"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="student@university.ac.uk"
                    android:inputType="textEmailAddress"
                    android:padding="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8" />

                <!-- Full Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Full Name"
                    android:textColor="#111827"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Enter full name"
                    android:inputType="textPersonName"
                    android:padding="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8" />

                <!-- Phone -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Phone Number"
                    android:textColor="#111827"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Enter phone number"
                    android:inputType="phone"
                    android:padding="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8" />

                <!-- Item Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Item Name"
                    android:textColor="#111827"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Enter item name"
                    android:padding="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8" />

                <!-- Category -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Category"
                    android:textColor="#111827"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Phone, Bag, Laptop..."
                    android:padding="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8" />

                <!-- Date Lost -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Date Lost"
                    android:textColor="#111827"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDateLost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="DD/MM/YYYY"
                    android:padding="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8" />

                <!-- Location -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Location Lost"
                    android:textColor="#111827"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Library, Classroom..."
                    android:padding="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Item Proof / Description"
                    android:textColor="#111827"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:background="@android:color/transparent"
                    android:gravity="top"
                    android:hint="Describe the item, colour, brand..."
                    android:padding="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitLost"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2563EB"
            android:text="Submit Lost Report"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>