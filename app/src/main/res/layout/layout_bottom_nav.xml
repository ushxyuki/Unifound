<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavRoot"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:clipChildren="false"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Home tab"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="56dp">

            <LinearLayout
                android:id="@+id/navHomePill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:minWidth="54dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/navHomeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Home"
                    android:src="@drawable/ic_home"
                    android:tint="@color/bottom_nav_unselected" />

                <TextView
                    android:id="@+id/navHomeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:maxLines="1"
                    android:text="Home"
                    android:textColor="@color/bottom_nav_selected"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navReports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Reports tab"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="56dp">

            <LinearLayout
                android:id="@+id/navReportsPill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:minWidth="54dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/navReportsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Reports"
                    android:src="@drawable/ic_reports"
                    android:tint="@color/bottom_nav_unselected" />

                <TextView
                    android:id="@+id/navReportsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:maxLines="1"
                    android:text="Reports"
                    android:textColor="@color/bottom_nav_selected"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="64dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Messages tab"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="56dp">

            <LinearLayout
                android:id="@+id/navMessagesPill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:minWidth="54dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/navMessagesIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Messages"
                    android:src="@drawable/ic_messages"
                    android:tint="@color/bottom_nav_unselected" />

                <TextView
                    android:id="@+id/navMessagesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:maxLines="1"
                    android:text="Messages"
                    android:textColor="@color/bottom_nav_selected"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Profile tab"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="56dp">

            <LinearLayout
                android:id="@+id/navProfilePill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:minWidth="54dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/navProfileIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Profile"
                    android:src="@drawable/ic_profile"
                    android:tint="@color/bottom_nav_unselected" />

                <TextView
                    android:id="@+id/navProfileLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:maxLines="1"
                    android:text="Profile"
                    android:textColor="@color/bottom_nav_selected"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/fabReport"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_fab_report"
        android:contentDescription="Create report"
        android:elevation="16dp"
        android:padding="15dp"
        android:src="@drawable/ic_plus"
        android:tint="@android:color/white" />
</FrameLayout>
